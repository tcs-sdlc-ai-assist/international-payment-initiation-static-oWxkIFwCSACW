# Environment variable template for intl-payment-initiation
# Copy this file to `.env.local` and adjust values as needed.
# All variables are non-sensitive build labels — DO NOT store secrets here.
# Vite only exposes variables prefixed with VITE_ to client code.

# Human-readable label for the current build, shown in the UI footer/about.
# Example: "dev", "staging", "release-2026.07".
VITE_APP_BUILD_LABEL=dev

# Identifier for the fixture data pack used to seed mock/demo data.
# Selects which set of static fixtures the app loads at runtime.
VITE_FIXTURE_PACK=default

# Reference date used for deterministic date calculations and fixtures.
# Must be an ISO 8601 date (YYYY-MM-DD).
VITE_REFERENCE_DATE=2026-07-28